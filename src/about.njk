<section id="contact">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Contact</div>
      <h2>Tell us about your situation.</h2>
      <p>For a working conversation about a specific challenge, the fastest route is to <a href="{{ site.calendly }}">book a 20-minute call</a>. Prefer to write first? Use the form below or email <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
    </div>

    <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks/" class="contact-form">
      <input type="hidden" name="form-name" value="contact">
      <p class="hp-field">
        <label>Don&rsquo;t fill this out if you&rsquo;re human: <input name="bot-field"></label>
      </p>
      <div>
        <label for="name">Name</label>
        <input id="name" type="text" name="name" required autocomplete="name">
      </div>
      <div>
        <label for="email">Email</label>
        <input id="email" type="email" name="email" required autocomplete="email">
      </div>
      <div>
        <label for="company">Company (optional)</label>
        <input id="company" type="text" name="company" autocomplete="organization">
      </div>
      <div>
        <label for="message">What&rsquo;s on your mind?</label>
        <textarea id="message" name="message" required></textarea>
      </div>
      <div>
        <button type="submit" class="btn-primary">Send message</button>
      </div>
    </form>
  </div>
</section>
